# Real IQVIA extracts are committed directly (Penn State's data license covers this
# public repo — see docs/PROPOSAL.md §3.1); no exclusion needed for data/raw/ or *.xlsx.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# MLflow / experiment tracking
mlruns/
mlartifacts/

# Generated warehouse database (pipeline.py output) - a build artifact, not source
# data, so it's excluded here the same way data/raw/'s real extracts are deliberately
# NOT excluded above. Meant to be DVC-tracked (PROPOSAL.md §19.6) once an actual DVC
# remote is stood up; until then the scheduled workflow uploads it as a CI artifact
# instead (.github/workflows/monthly_pipeline.yml) rather than committing it here.
data/processed/

# Environment / secrets
.env
*.env.local

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Build artifacts
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/
